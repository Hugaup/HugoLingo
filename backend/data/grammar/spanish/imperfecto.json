      ["1-05", "¿Qué ___ (hacer, tú) a esa hora todos los días?", "hacías", ["hacias", "hacíais", "hacabas"], "-er: hacías."],
      ["1-06", "Antes ___ (ver, nosotros) mucho la tele.", "veíamos", ["víamos", "veímos", "veábamos"], "ver keeps its e: veíamos."],
      ["1-07", "Antes mis padres ___ (trabajar) en un banco.", "trabajaban", ["trabajeban", "trabajábamos", "trabajían"], "-ar: trabajaban."],
      ["1-08", "Hacía frío y ___ (llover).", "llovía", ["lloviba", "llovió de", "llueve"], "-er: llovía."],
      ["1-09", "De niños, vosotros ___ (tener) un perro, ¿no?", "teníais", ["tenáis", "teníamos", "tenabais"], "-er: teníais."],
      ["1-10", "Yo ___ (estar) muy cansada.", "estaba", ["estuve de", "estía", "estába"], "-ar: estaba."],
      ["1-11", "Los niños ___ (dormir) cuando llegué.", "dormían", ["durmían", "dormieron", "dormaban"], "-ir: dormían (no stem change)."],
