      ["1-02", "El año que viene ___ (estudiar, yo) en Madrid.", "estudiaré", ["estudiaré de", "estudiare", "estudiará"], "Infinitive + -é: estudiaré."],
      ["1-03", "¿___ (venir, tú) a mi boda?", "Vendrás", ["Vendrás de", "Venirás", "Vienerás"], "Irregular stem: vendr-."],
