      ["1-06", "Te lo ___ (decir, yo) mañana.", "diré", ["deciré", "diría", "dicaré"], "Irregular stem: dir-."],
      ["1-07", "No sé si ___ (poder, nosotros) ir.", "podremos", ["poderemos", "podríamos de", "puedremos"], "Irregular stem: podr-."],
      ["1-08", "¿Vosotros ___ (tener) tiempo el sábado?", "tendréis", ["teneréis", "tendríais", "tenéréis"], "Irregular stem: tendr-."],
      ["1-09", "En el futuro ___ (haber) coches voladores.", "habrá", ["haberá", "habrán", "hará"], "haber: habrá (always singular)."],
      ["1-10", "—¿Dónde está Juan? —No sé, ___ (estar) en casa.", "estará", ["estaré", "esté", "estaría de"], "A guess about the present: future."],
      ["1-11", "Ella ___ (saber) la respuesta.", "sabrá", ["saberá", "sabría de", "sepá"], "Irregular stem: sabr-."],
