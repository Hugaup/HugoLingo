{
  "id": "futuro", "title": "The future", "spanish": "Futuro simple", "category": "conjugation", "level": 2,
  "rule": [
    "Infinitive + -é, -ás, -á, -emos, -éis, -án: hablaré, comerás, vivirá.",
    "Irregular stems (same endings): tendré, vendré, pondré, saldré, podré, sabré, querré, haré, diré, habrá.",
